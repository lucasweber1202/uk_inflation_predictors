# Environment switch
# PROD=True uses Databricks; PROD=False uses PREDICTORS_DB_URL.
PROD=false
PREDICTORS_DB_URL=postgresql+psycopg2://user:password@localhost:5432/macrobond_inhouse

# Pipeline
PREDICTORS_LOG_LEVEL=INFO
# Local directory holding raw downloaded source files. Gitignored: the
# source_snapshots table, not Git, is the traceability record.
PREDICTORS_RAW_DIR=_raw

# HTTP
PREDICTORS_HTTP_TIMEOUT=60
PREDICTORS_DOWNLOAD_DELAY=1
PREDICTORS_MAX_RETRIES=3
PREDICTORS_BACKOFF_FACTOR=2
PREDICTORS_RATE_LIMIT_BACKOFF=20
PREDICTORS_MAX_RETRY_DELAY=120
PREDICTORS_MAX_DOWNLOAD_BYTES=134217728

# Databricks / Azure Key Vault (PROD only)
DBX_SERVER_HOSTNAME=
DBX_HTTP_PATH=
AKV_VAULT_URL=
AKV_SECRET_NAME=databricks-token
DATABRICKS_TOKEN=
